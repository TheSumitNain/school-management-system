
APP_ENV=development
APP_PORT=8081

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_NAME=school_management
DB_PASSWORD=
DB_SSLMODE=disable
# JWT authentication
JWT_SECRET=replace-with-a-secure-random-secret
JWT_ISSUER=school-management-system
JWT_ACCESS_EXPIRY_MINUTES=15

# MFA TOTP encryption (generate a random 32-byte key and Base64-encode it)
TOTP_ENCRYPTION_KEY=
TOTP_ENCRYPTION_KEY_VERSION=1
# Optional comma-separated old-key entries: version:Base64,version:Base64
# Keep each previous key configured until all stored credentials have rotated.
TOTP_ENCRYPTION_PREVIOUS_KEYS=
